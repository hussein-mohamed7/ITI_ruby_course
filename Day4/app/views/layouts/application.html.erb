<!DOCTYPE html>
<html>
  <head>
    <title>Day4</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
  </head>

  <body>

    <% if user_signed_in? %>

      Logged in as:
      <strong><%= current_user.email %></strong>

      <%= button_to "Logout",
      destroy_user_session_path,
      method: :delete %>

    <% else %>

      <%= link_to "Login", new_user_session_path %>

      <%= link_to "Register", new_user_registration_path %>

    <% end %>

    <hr>

    <%= yield %>

  </body>
</html>