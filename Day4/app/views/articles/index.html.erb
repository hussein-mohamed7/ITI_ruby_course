<h1>Articles</h1>

<% if user_signed_in? %>
  <%= link_to "New Article", new_article_path %>
<% end %>

<hr>

<% @articles.each do |article| %>

  <h3>
    <%= link_to article.title, article %>
  </h3>

  <p>
    <%= truncate(article.content, length: 100) %>
  </p>

  <p>
    Author:
    <%= article.user.email %>
  </p>

  <p>
    Reports:
    <%= article.reports_count %>
  </p>

  <hr>

<% end %>