<div id="<%= dom_id article %>">
  <div>
    <strong>Title:</strong>
    <%= article.title %>
  </div>

  <div>
    <strong>Content:</strong>
    <%= article.content %>
  </div>

  <div>
    <strong>Image:</strong>
    <%= article.image %>
  </div>

  <div>
    <strong>User:</strong>
    <%= article.user_id %>
  </div>

  <div>
    <strong>Reports count:</strong>
    <%= article.reports_count %>
  </div>

  <div>
    <strong>Archived:</strong>
    <%= article.archived %>
  </div>

</div>
